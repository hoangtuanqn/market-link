# Giá trị mặc định khi build production; Docker ghi đè bằng build arg VITE_API_URL (.env.production ở root)
VITE_API_URL=http://localhost:8080

# Bản đồ: file này ĐƯỢC COMMIT nên không đặt key ở đây.
# Key riêng của máy bạn đặt trong frontend/.env.development.local (đã gitignore).
# Không đặt gì thì bản đồ dùng tile OpenStreetMap — xem src/config/map.ts.
