# Default values for the production build; Docker overrides with the build arg VITE_API_URL (.env.production at the root)
VITE_API_URL=http://localhost:8080

# Map: this file IS COMMITTED so do not put a key here.
# Put your own machine's key in frontend/.env.development.local (git-ignored).
# If nothing is set the map uses OpenStreetMap tiles — see src/config/map.ts.
