# ---------------------------------------------------------------------
# Template for the "dev" profile. Copy to application-dev.yaml (git-ignored) and fill in your own values:
#   cp application-dev.yaml.example application-dev.yaml
# Only holds sensitive keys — other configuration lives in application.yaml.
# The default DB values match .env.example.
# ---------------------------------------------------------------------
spring:
  # Apply missing migrations numbered lower than the one the DB already ran (two branches merged out of order). Dev only.
  flyway:
    out-of-order: true
  datasource:
    username: ${MYSQL_USER:intervue}
    password: ${MYSQL_PASSWORD:intervue_pass}
  # Gmail + App Password (Google Account → Security → App passwords)
  mail:
    username: ${MAIL_USERNAME:your-email@gmail.com}
    password: ${MAIL_PASSWORD:your-gmail-app-password}

jwt:
  # Secret for dev only
  secret: ${JWT_SECRET:ZGV2LW9ubHktand0LXNlY3JldC1tYXJrZXRsaW5rLWRvLW5vdC11c2UtaW4tcHJvZA==}

# Google sign-in — replace the sample values with real keys (Google Cloud Console)
app:
  oauth:
    google:
      client-id: ${GOOGLE_CLIENT_ID:your-google-client-id.apps.googleusercontent.com}
      client-secret: ${GOOGLE_CLIENT_SECRET:your-google-client-secret}
