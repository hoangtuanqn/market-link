# ---------------------------------------------------------------------
# Mẫu cho profile "prod". Trên server, copy thành application-prod.yaml (git-ignore) trước khi build:
#   cp application-prod.yaml.example application-prod.yaml
# Chỉ chứa key nhạy cảm, lấy từ biến môi trường (.env.production) và KHÔNG có mặc định:
# thiếu biến nào là ứng dụng dừng ngay lúc khởi động thay vì chạy với secret mẫu.
# ---------------------------------------------------------------------
spring:
  datasource:
    url: ${SPRING_DATASOURCE_URL}
    username: ${MYSQL_USER}
    password: ${MYSQL_PASSWORD}
  # Mail chưa bắt buộc ở prod: bỏ trống thì app vẫn chạy, chỉ gửi mail quên mật khẩu thất bại
  mail:
    username: ${MAIL_USERNAME:}
    password: ${MAIL_PASSWORD:}

jwt:
  secret: ${JWT_SECRET}

# FR-008: khoá mã hoá TOTP của admin, không có giá trị mặc định ở prod
app:
  mfa:
    encryption-key: ${MFA_ENCRYPTION_KEY}
  # FR-111: chat realtime qua RabbitMQ; bắt buộc ở prod
  chat:
    rabbitmq:
      host: ${RABBITMQ_HOST}
      stomp-port: ${RABBITMQ_STOMP_PORT}
      user: ${RABBITMQ_USER}
      password: ${RABBITMQ_PASSWORD}
