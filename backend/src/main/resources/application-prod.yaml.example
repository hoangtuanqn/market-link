# ---------------------------------------------------------------------
# Template for the "prod" profile. On the server, copy to application-prod.yaml (git-ignored) before building:
#   cp application-prod.yaml.example application-prod.yaml
# Only holds sensitive keys, taken from environment variables (.env.production) with NO defaults:
# if any variable is missing the app stops right at startup instead of running with a sample secret.
# ---------------------------------------------------------------------
spring:
  datasource:
    url: ${SPRING_DATASOURCE_URL}
    username: ${MYSQL_USER}
    password: ${MYSQL_PASSWORD}
  # Mail is not required in prod: if left empty the app still runs, only the forgot-password email fails to send
  mail:
    username: ${MAIL_USERNAME:}
    password: ${MAIL_PASSWORD:}

jwt:
  secret: ${JWT_SECRET}

# FR-008: the admin's TOTP encryption key, no default value in prod
app:
  mfa:
    encryption-key: ${MFA_ENCRYPTION_KEY}
  # FR-111: realtime chat through RabbitMQ; required in prod
  chat:
    rabbitmq:
      host: ${RABBITMQ_HOST}
      stomp-port: ${RABBITMQ_STOMP_PORT}
      user: ${RABBITMQ_USER}
      password: ${RABBITMQ_PASSWORD}
