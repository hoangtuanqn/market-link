# =====================================================================
# Môi trường DEV (nhánh dev, máy của từng thành viên)
#   cp .env.example .env      (hoặc: make init)
# Giá trị dưới đây khớp application-dev.yaml nên không cần sửa gì vẫn chạy được.
# File .env đã git-ignore — không commit.
# =====================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=intervue_db
MYSQL_USER=intervue
MYSQL_PASSWORD=intervue_pass

# ---------- Backend ----------
SPRING_PROFILES_ACTIVE=dev
# Bỏ trống: dùng secret dev trong application-dev.yaml
# JWT_SECRET=
# Bỏ trống: dùng khoá dev trong application.yaml (FR-008, mã hoá khoá TOTP của admin)
# MFA_ENCRYPTION_KEY=
# Origin frontend được gọi API (CORS), nhiều origin cách nhau dấu phẩy
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Đăng nhập Google ở dev: key đặt trong application-dev.yaml (hoặc application-local.yml,
# git-ignore). Các biến GOOGLE_CLIENT_ID/SECRET cũng ghi đè được nếu export
# trong shell trước khi chạy BE. Docker dev không truyền các biến này vào container.

# ---------- RabbitMQ (FR-111: chat realtime, plugin STOMP) ----------
RABBITMQ_USER=marketlink
RABBITMQ_PASSWORD=marketlink_pass

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8080

# ---------- Cổng expose ra máy host ----------
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8080
BACKEND_DEBUG_PORT=5005
FRONTEND_PORT=3000
ADMINER_PORT=8081
REDISINSIGHT_PORT=5540
RABBITMQ_UI_PORT=15672

TZ=Asia/Ho_Chi_Minh
