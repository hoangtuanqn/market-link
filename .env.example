# =====================================================================
# DEV environment (dev branch, each member's own machine)
#   cp .env.example .env      (or: make init)
# The values below match application-dev.yaml, so it runs as-is without any edit.
# The .env file is git-ignored — do not commit it.
# =====================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=intervue_db
MYSQL_USER=intervue
MYSQL_PASSWORD=intervue_pass

# ---------- Backend ----------
SPRING_PROFILES_ACTIVE=dev
# Empty = true: Flyway applies missing migrations numbered lower than the latest one the DB has run (two branches merged out of order)
# SPRING_FLYWAY_OUT_OF_ORDER=true
# Empty: use the dev secret from application-dev.yaml
# JWT_SECRET=
# Empty: use the dev key from application.yaml (FR-008, encrypts the admin's TOTP key)
# MFA_ENCRYPTION_KEY=
# Frontend origins allowed to call the API (CORS), separated by commas
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secure flag of the refresh_token cookie (FR-003). localhost counts as secure, so dev keeps true.
COOKIE_SECURE=true
# Google sign-in in dev: put the keys in application-dev.yaml (or application-local.yml,
# git-ignored). The GOOGLE_CLIENT_ID/SECRET variables can also override them if exported
# in the shell before starting the BE. Dev Docker does not pass these variables into the container.

# ---------- Mail (FR-009 sign-up code, FR-007 password reset) ----------
# Gmail: turn on 2-Step Verification, create an App Password, paste it below (docs/setup.md).
# Empty MAIL_USERNAME = mails are written to the backend log instead of being sent.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# FR-072 account status emails: the "Sign in" link in the reactivation email, and the address a
# locked-out customer is told to write to.
SIGN_IN_URL=http://localhost:3000/login
SUPPORT_EMAIL=admin@marketlink.vn
# FR-007: the frontend's password reset page; the email links to <url>?token=<token>
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# ---------- RabbitMQ (FR-111: chat realtime, plugin STOMP) ----------
RABBITMQ_USER=marketlink
RABBITMQ_PASSWORD=marketlink_pass

# ---------- Web Push (FR-042 N3: notifications after the tab is closed) ----------
# Generate the key pair with make vapid-keys and paste the two printed lines here. Empty → Web Push is off, the app still runs.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@marketlink.local

# ---------- Chat photo/video attachments + abuse protection (FR-115, spec §8.2/§8.4, 2026-09-28 chat media) ----------
# This directory is SEPARATE from /uploads: chat photos and videos are only served through GET /api/v1/attachments/{id}
# (or its signed stream link), which checks permissions. Max 50 MB per file; CHAT_IMAGES_PER_HOUR counts photos and videos together.
CHAT_UPLOAD_DIR=/var/lib/marketlink/chat
CHAT_MAX_UPLOAD_BYTES=52428800
CHAT_MESSAGES_PER_MINUTE=30
CHAT_IMAGES_PER_HOUR=10
CHAT_CONVERSATIONS_PER_HOUR=20
CHAT_TYPING_FRAMES_PER_MINUTE=120

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8080
# ---------- Map (D-12) ----------
# Empty = use OpenStreetMap tiles: no account needed, within their policy for
# normal map browsing, but with no uptime commitment. A deployment with real traffic should point
# to its own provider. A key in the URL is a browser-side key: it ends up in the bundle and anyone can
# read it — restrict it by domain in the provider's console, do not treat it as a secret.
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v4/256/{z}/{x}/{y}.png?key=<key>
# VITE_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors

# ---------- Ports exposed to the host machine ----------
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8080
BACKEND_DEBUG_PORT=5005
FRONTEND_PORT=3000
ADMINER_PORT=8081
REDISINSIGHT_PORT=5540
RABBITMQ_UI_PORT=15672

TZ=Asia/Ho_Chi_Minh

# ---------- AI assistant (FR-090/091: Claude answers signed-in customers) ----------
# Get a key at https://console.anthropic.com. Empty → the chatbot uses the keyword engine only, the app still runs.
ANTHROPIC_API_KEY=
# A cheap, fast model is enough for lookups and FAQ answers
CHATBOT_AI_MODEL=claude-haiku-4-5
# Messages per account per hour answered by Claude; over it the keyword engine answers (bounds the API bill)
CHATBOT_AI_MESSAGES_PER_HOUR=30
# Admin is a small, trusted group, so it gets a higher hourly cap
CHATBOT_AI_ADMIN_MESSAGES_PER_HOUR=60
# Cap for the whole platform per day. Unlike the per-account cap this one fails CLOSED:
# if Redis is unreachable the spend cannot be measured, so the keyword engine answers.
CHATBOT_AI_PLATFORM_MESSAGES_PER_DAY=1500
