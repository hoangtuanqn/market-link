# =====================================================================
# Môi trường PRODUCTION (nhánh main, máy demo / server)
#   cp .env.production.example .env.production   rồi thay TẤT CẢ giá trị <...>
#   make prod
# File .env.production đã git-ignore — KHÔNG BAO GIỜ commit.
# Thiếu biến bắt buộc thì compose / backend dừng ngay, không chạy với giá trị mẫu.
# =====================================================================

# ---------- MySQL (không mở cổng ra ngoài, chỉ backend truy cập) ----------
MYSQL_ROOT_PASSWORD=<openssl rand -base64 24>
MYSQL_DATABASE=marketlink_prod
MYSQL_USER=marketlink
MYSQL_PASSWORD=<openssl rand -base64 24>

# ---------- Backend ----------
SPRING_PROFILES_ACTIVE=prod
# Base64, >= 32 byte:  openssl rand -base64 48
JWT_SECRET=<openssl rand -base64 48>
# FR-008: mã hoá khoá TOTP của admin, đúng 32 byte:  openssl rand -base64 32
# Đổi khoá này thì mọi admin đã bật 2FA phải cài lại
MFA_ENCRYPTION_KEY=<openssl rand -base64 32>
# Origin (scheme + domain + cổng nếu có) của frontend, vd https://marketlink.example.com — nhiều cái cách nhau dấu phẩy
CORS_ALLOWED_ORIGINS=<URL frontend mà người dùng mở trên trình duyệt>
# Đăng nhập Google (bỏ trống thì tính năng trả 503). redirect-uri phải khớp cấu hình trên console.
GOOGLE_CLIENT_ID=<Google Cloud Console → Credentials → OAuth client ID>
GOOGLE_CLIENT_SECRET=<client secret của OAuth client trên>
GOOGLE_REDIRECT_URI=<URL frontend>/auth/google/callback

# ---------- Frontend ----------
# URL backend mà TRÌNH DUYỆT gọi tới — nhúng vào bundle lúc build
VITE_API_URL=http://localhost:8080
# ---------- Bản đồ (D-12) ----------
# Bỏ trống = dùng tile OpenStreetMap: không cần tài khoản, hợp chính sách của họ cho việc
# duyệt bản đồ bình thường, nhưng không có cam kết uptime. Deploy có lưu lượng thật thì trỏ
# sang nhà cung cấp riêng. Key trong URL là key phía trình duyệt, nằm trong bundle và ai cũng
# đọc được — khoá nó theo tên miền ở trang quản trị của nhà cung cấp, đừng coi là bí mật.
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v4/256/{z}/{x}/{y}.png?key=<key>
# VITE_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors

# ---------- Cổng expose ra máy host ----------
BACKEND_PORT=8080
FRONTEND_PORT=80

TZ=Asia/Ho_Chi_Minh
