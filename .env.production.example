# =====================================================================
# PRODUCTION environment (main branch, demo machine / server)
#   cp .env.production.example .env.production   then replace ALL <...> values
#   make prod
# The .env.production file is git-ignored — NEVER commit it.
# If a required variable is missing, compose / the backend stops immediately instead of running with sample values.
# =====================================================================

# ---------- MySQL (no port exposed outside, only the backend connects) ----------
MYSQL_ROOT_PASSWORD=<openssl rand -base64 24>
MYSQL_DATABASE=marketlink_prod
MYSQL_USER=marketlink
MYSQL_PASSWORD=<openssl rand -base64 24>

# ---------- RabbitMQ (no port exposed outside, only the backend connects) ----------
RABBITMQ_USER=marketlink
RABBITMQ_PASSWORD=<openssl rand -base64 24>
# Web Push (FR-042): make vapid-keys. Browsers only allow Web Push over HTTPS.
VAPID_PUBLIC_KEY=<make vapid-keys>
VAPID_PRIVATE_KEY=<make vapid-keys>
VAPID_SUBJECT=mailto:<email liên hệ>
# AI assistant (FR-090/091): Claude API key from console.anthropic.com. Empty → keyword chatbot only.
ANTHROPIC_API_KEY=
CHATBOT_AI_MODEL=claude-haiku-4-5
CHATBOT_AI_MESSAGES_PER_HOUR=30
# Admin is a small, trusted group, so it gets a higher hourly cap
CHATBOT_AI_ADMIN_MESSAGES_PER_HOUR=60
# Cap for the whole platform per day. Unlike the per-account cap this one fails CLOSED:
# if Redis is unreachable the spend cannot be measured, so the keyword engine answers.
CHATBOT_AI_PLATFORM_MESSAGES_PER_DAY=1500

# ---------- Chat image attachments + abuse protection (FR-115, spec §8.2/§8.4) ----------
# Path INSIDE the container (chat-uploads volume), not a path on the host.
CHAT_UPLOAD_DIR=/var/lib/marketlink/chat
CHAT_MAX_UPLOAD_BYTES=5242880
CHAT_MESSAGES_PER_MINUTE=30
CHAT_IMAGES_PER_HOUR=10
CHAT_CONVERSATIONS_PER_HOUR=20
CHAT_TYPING_FRAMES_PER_MINUTE=120

# ---------- Backend ----------
SPRING_PROFILES_ACTIVE=prod
# Base64, >= 32 byte:  openssl rand -base64 48
JWT_SECRET=<openssl rand -base64 48>
# FR-008: encrypts the admin's TOTP key, exactly 32 bytes:  openssl rand -base64 32
# Changing this key means every admin who enabled 2FA must set it up again
MFA_ENCRYPTION_KEY=<openssl rand -base64 32>
# Frontend origin (scheme + domain + port if any), e.g. https://marketlink.example.com — separate several with commas
CORS_ALLOWED_ORIGINS=<URL frontend mà người dùng mở trên trình duyệt>
# Google sign-in (empty makes the feature return 503). The redirect-uri must match the console configuration.
GOOGLE_CLIENT_ID=<Google Cloud Console → Credentials → OAuth client ID>
GOOGLE_CLIENT_SECRET=<client secret của OAuth client trên>
GOOGLE_REDIRECT_URI=<URL frontend>/auth/google/callback

# ---------- Mail (FR-009 sign-up code, FR-007 password reset) ----------
# Gmail: turn on 2-Step Verification, create an App Password, paste it below (docs/setup.md).
# Empty MAIL_USERNAME = mails are written to the backend log instead of being sent.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- Frontend ----------
# Backend URL that the BROWSER calls — embedded into the bundle at build time
VITE_API_URL=http://localhost:8080
# ---------- Map (D-12, FR-012) ----------
# Google Maps Platform key with only the Map Tiles API enabled (docs/setup.md, section 8), embedded into
# the bundle at build time. Empty → OpenStreetMap tiles. Restrict it to the production domain (HTTP referrer)
# and cap the daily tiles in the Google console: anyone can read a browser key.
VITE_GOOGLE_MAPS_KEY=<Google Cloud Console → Credentials → API key, Map Tiles API only>

# ---------- Ports exposed to the host machine ----------
BACKEND_PORT=8080
FRONTEND_PORT=80

TZ=Asia/Ho_Chi_Minh
