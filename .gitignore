# ---------------------------------------------------------------------
# Operating system files (differ between Windows/macOS/Linux -> always ignore)
# ---------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.Trash-*

# ---------------------------------------------------------------------
# VS Code
# Only ignore personal / machine-local configuration.
# Configuration files shared by the whole team (settings/extensions/launch/tasks)
# should be committed so every machine has the same setup and avoids conflicts.
# ---------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.history/
*.code-workspace

# ---------------------------------------------------------------------
# Other IDEs (if a member uses IntelliJ / Eclipse / NetBeans)
# ---------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# ---------------------------------------------------------------------
# Environment variables & secrets — never commit
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
# Vite env files only hold public VITE_* variables (embedded in the bundle) → they are committed
!frontend/.env.development
!frontend/.env.production
*.pem
*.key
*.p12
*.jks
application-local.yml
# Contains environment-specific sensitive keys — create from application-<profile>.yaml.example
backend/src/main/resources/application-dev.yaml
backend/src/main/resources/application-prod.yaml
application-local.yaml
application-local.properties

# Claude Code: .claude/settings.json is shared (committed), settings.local.json is per machine
.claude/settings.local.json

# ---------------------------------------------------------------------
# Log files
# ---------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------
# Backend (Java / Spring Boot / Maven / Gradle)
# In case the build runs at the root or the IDE creates output at the root.
# ---------------------------------------------------------------------
target/
# Images users upload when the backend runs on the host (default app.storage.dir)
backend/uploads/
!**/src/main/**/target/
!**/src/test/**/target/
build/
!**/src/main/**/build/
!**/src/test/**/build/
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar
# Images/videos from Farmer applications stored locally (FarmerUploadService, app.uploads.dir) — do not commit.
backend/uploads/

# ---------------------------------------------------------------------
# Frontend (Node.js / Vite)
# ---------------------------------------------------------------------
node_modules/
out/
dist/
coverage/
*.tsbuildinfo

# ---------------------------------------------------------------------
# AI session transcripts (exported locally for reference, containing file contents and logs)
# ---------------------------------------------------------------------
docs/session-*.md

# ---------------------------------------------------------------------
# Other
# ---------------------------------------------------------------------
*.tmp
*.bak
*.swp
*.orig
